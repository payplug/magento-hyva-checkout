<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.payment.methods">
            <block name="checkout.payment.method.payplug-apple-pay"
                   as="payplug_payments_apple_pay"
                   class="Payplug\PaymentsHyvaCheckout\Block\ApplePay"
                   template="Payplug_PaymentsHyvaCheckout::hyva-checkout/payment/method/apple-pay.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">\Payplug\PaymentsHyvaCheckout\Magewire\ApplePay</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Payplug_Payments::images/logos/apple_pay.svg</item>
                            <item name="attributes" xsi:type="array">
                                <item name="width" xsi:type="number">50</item>
                                <item name="height" xsi:type="number">34</item>
                                <item name="loading" xsi:type="string">lazy</item>
                                <item name="alt" xsi:type="string">Apple Pay</item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.payplug_payments_oney"
                   as="payplug_payments_oney"
                   class="Payplug\Payments\Block\Oney\Simulation"
                   template="Payplug_PaymentsHyvaCheckout::hyva-checkout/payment/method/oney.phtml">
                 <arguments>
                    <argument name="magewire" xsi:type="object">\Payplug\PaymentsHyvaCheckout\Magewire\Oney</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Payplug_Payments::images/logos/oney_3x_4x.svg</item>
                            <item name="attributes" xsi:type="array">
                                <item name="width" xsi:type="number">120</item>
                                <item name="height" xsi:type="number">25</item>
                                <item name="loading" xsi:type="string">lazy</item>
                                <item name="alt" xsi:type="string">Oney</item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.payplug_payments_oney_without_fees"
                   as="payplug_payments_oney_without_fees"
                   class="Payplug\Payments\Block\Oney\Simulation"
                   template="Payplug_PaymentsHyvaCheckout::hyva-checkout/payment/method/oney.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">\Payplug\PaymentsHyvaCheckout\Magewire\Oney</argument>
