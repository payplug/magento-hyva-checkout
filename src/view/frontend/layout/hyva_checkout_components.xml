            <block name="checkout.payment.method.payplug_payments_wero"
                   as="payplug_payments_wero"
                   template="Payplug_PaymentsHyvaCheckout::hyva-checkout/payment/method/ppro.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">\Payplug\PaymentsHyvaCheckout\Magewire\Ppro</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Payplug_Payments::images/logos/wero.svg</item>
                            <item name="attributes" xsi:type="array">
                                <item name="width" xsi:type="number">86</item>
