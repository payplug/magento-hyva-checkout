                                <item name="loading" xsi:type="string">lazy</item>
                                <item name="alt" xsi:type="string">Oney</item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.payplug_payments_ideal"
                   as="payplug_payments_ideal"
