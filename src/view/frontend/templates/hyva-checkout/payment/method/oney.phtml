declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Payplug\Payments\Gateway\Config\OneyWithoutFees;
use Payplug\Payments\ViewModel\Oney;
use Payplug\PaymentsHyvaCheckout\Magewire\Oney as OneyMagewire;
use Payplug\PaymentsHyvaCheckout\ViewModel\PayplugIcons;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var OneyMagewire $magewire */

$oneyType = (string) $block->getData('method_code');
$oneyViewModel = $viewModels->require(Oney::class);
$config = $oneyViewModel->getConfig($oneyViewModel->getCartAmount(), $oneyType);
$message = $magewire->getErrorMessage($config);
$isOneyWithoutFees = $oneyType === OneyWithoutFees::METHOD_CODE;
$icons = $viewModels->require(PayplugIcons::class);
$label = __($isOneyWithoutFees ? 'Payment in %1 without fees' : 'Payment in %1');
?>

<div class="pl-11 pr-4 pb-4">
    <?php if ($message !== ''): ?>
        <div class="text-payment-error font-medium text-sm" data-oney-error>
            <?= $escaper->escapeHtml($message) ?>
        </div>
    <?php else: ?>
        <div id="pp-oney-payment"
             data-label="<?= $escaper->escapeHtmlAttr($label) ?>"
             data-config="<?= $escaper->escapeHtmlAttr($oneyViewModel->getJsConfig($config, false)) ?>"
        >
            <div wire:ignore>
                <div class="oney-payment">
                    <?php foreach ($config['options'] ?? [] as $option): ?>
                        <?php $optionId = 'oney-option-' . $oneyType . '-' . $option ?>
                        <div class="field">
                            <input type="radio"
                                   id="<?= $escaper->escapeHtmlAttr($optionId) ?>"
                                   name="oney_type"
                                   value="<?= $escaper->escapeHtmlAttr($option) ?>"
                                   class="sr-only"
                            />
                            <label for="<?= $escaper->escapeHtmlAttr($optionId) ?>"
                                   class="oney-option"
                            >
                                <span class="oney-option-title">
                                    <?= /* @noEscape */ $icons->renderHtml(
                                        'oney/' . $option . ($isOneyWithoutFees ? '-without-fees' : ''),
                                        '',
                                        150,
                                        32,
                                        ['aria-hidden' => 'true']
                                    ) ?>
                                    <?= $escaper->escapeHtml(
                                        __($isOneyWithoutFees ? 'Payment in %1 at no cost' : 'Payment in %1', $option)
                                    ) ?>
                                </span>
                            </label>
                        </div>
                    <?php endforeach; ?>
                </div>
                <p class="<?= empty($config['options']) ? '' : 'hidden ' ?>text-sm text-gray-500"
                   role="status"
                   data-oney-notice
                >
                    <?= $escaper->escapeHtml(__(
                        'Your payment schedule simulation is temporarily unavailable. ' .
                        'You will find this information at the payment stage.'
                    )) ?>
                </p>
                <div class="relative" aria-busy="false" data-oney-widget>
                    <div class="hidden" role="status" data-oney-loader>
                        <div class="absolute inset-0 z-10 flex items-center justify-center">
                            <span class="h-8 w-8 animate-spin rounded-full border-4 border-oney border-t-transparent">
                            </span>
                        </div>
                        <span class="sr-only">
                            <?= $escaper->escapeHtml(__('Loading the Oney payment schedule...')) ?>
                        </span>
                    </div>
                    <div id="<?= $escaper->escapeHtmlAttr('oney-checkout-placeholder-' . $oneyType) ?>"
                         data-oney-placeholder
                    ></div>
                </div>
            </div>
        </div>
    <?php endif; ?>
</div>
