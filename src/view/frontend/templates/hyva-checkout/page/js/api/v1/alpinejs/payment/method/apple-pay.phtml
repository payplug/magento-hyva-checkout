declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Payplug\Payments\ViewModel\UrlProvider;

/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
/** @var Template $block */
/** @var UrlProvider $urlProvider */
/** @var ViewModelRegistry $viewModels */

$urlProvider = $viewModels->require(UrlProvider::class);
?>
<script>
    (() => {
        hyvaCheckout.api.after(() => {
            const isApplePayEnabled = <?= $urlProvider->isApplePayEnabled() ? 'true' : 'false' ?>;
            const cancelUrl = '<?= $escaper->escapeUrl($block->getUrl('payplug_payments/payment/cancel')) ?>';
            const isApplePayAvailable = () => !!window.ApplePaySession?.canMakePayments();
            let isProcessing = false;
            let applePayApiLoaded;
            let btnPlaceOrder;

            const applePayMethod = hyvaCheckout.payment.registerMethod({
                code: 'payplug_payments_apple_pay',
                method: {
                    initialize: async function () {
                        const appleEl = document.getElementById('pp-apple-pay-payment');
                        if (!appleEl) return;

                        this.loadApplePayApi().then(async () => {
                            if (this.checkLoadedAP()) {
                                if (isApplePayAvailable()) {
                                    document.querySelector('apple-pay-button').addEventListener('click', async () => {
                                        if (isProcessing) return;

                                        isProcessing = true;

                                        try {
                                            this.initApplePay();
                                            await hyvaCheckout.order.place();
                                        } finally {
                                            isProcessing = false;
                                        }
                                    });
                                }

                                btnPlaceOrder = document.querySelector('.btn-place-order');

                                if (btnPlaceOrder) {
                                    btnPlaceOrder.disabled = true;
                                }
                            }
                        });
                    },
                    initApplePay: function() {
                        if (!window.ApplePaySession) {
                            return;
                        }

                        const versionNumber = this.getApplePayVersion();
                        const sessionRequest = this.getApplePaySessionRequest(versionNumber);
                        const session = new ApplePaySession(versionNumber, sessionRequest);

                        hyvaCheckout.evaluation.registerExecutable('make:pay-plug:payment', () => {
                            magewire.plugins.loader.start();
                            return new Promise((resolve) => {
                                session.onvalidatemerchant = async () => {
                                    fetch('<?= $escaper->escapeUrl($block->getUrl("payplug_payments/applepay/getTransactionData")); ?>').then(async response => {
                                        let res = await response.json();
                                        if (res.error === true) {
                                            window.location.replace('<?= $escaper->escapeUrl($block->getUrl('payplug_payments/payment/cancel')); ?>');
                                            resolve();
                                        } else {
                                            session.completeMerchantValidation(res.merchand_data);
                                        }
                                    }).catch(() => {
                                        window.location.replace(cancelUrl);
                                        resolve();
                                    });
                                };

                                session.onpaymentauthorized = event => {
                                    const body = new URLSearchParams({
                                        form_key: hyva.getFormKey()
                                    });

                                    const appendTokenParam = (key, value) => value instanceof Object
                                        ? Object.entries(value).forEach(([name, item]) => appendTokenParam(`${key}[${name}]`, item))
                                        : body.append(key, value ?? '');

                                    appendTokenParam('token', event.payment.token);

                                    fetch('<?= $escaper->escapeUrl($block->getUrl("payplug_payments/applepay/updateTransaction")); ?>', {
                                        method: 'POST',
                                        credentials: "include",
                                        body,
                                        headers: {
                                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                                        }
                                    }).then(async response => {
                                        let res = await response.json();
                                        let applePaySessionStatus = ApplePaySession.STATUS_SUCCESS;
                                        if (res.error === true) {
                                            applePaySessionStatus = ApplePaySession.STATUS_FAILURE;
                                        }
                                        session.completePayment({
                                            "status": applePaySessionStatus
                                        });
                                        if (res.error === true) {
                                            window.location.replace('<?= $escaper->escapeUrl($block->getUrl('payplug_payments/payment/cancel')); ?>');
                                            resolve();
                                        } else {
                                            window.location.replace('<?= $escaper->escapeUrl($block->getUrl('payplug_payments/payment/paymentReturn')); ?>');
                                            resolve();
                                        }
                                    }).catch(() => {
                                        window.location.replace(cancelUrl);
                                        resolve();
                                    });
                                };

                                session.oncancel = event => {
                                    window.location.replace('<?= $escaper->escapeUrl($block->getUrl('payplug_payments/payment/cancel')); ?>');
                                    resolve();
                                };

                                session.begin();
                            });
                        });
                    },
                    getApplePayVersion: function() {
                        return ApplePaySession.supportsVersion(14) ? 14 : 3;
                    },
                    getApplePaySessionRequest: function(versionNumber) {
                        const {
                            domain,
                            merchantName,
                            merchantCountryId,
                            total
                        } = document.getElementById('pp-apple-pay-payment').dataset;

                        return {
                            "countryCode": merchantCountryId,
                            "currencyCode": 'EUR',
                            "merchantCapabilities": ["supports3DS"],
                            "supportedNetworks": versionNumber >= 4
                                ? ['cartesBancaires', 'visa', 'masterCard']
                                : ['visa', 'masterCard'],
                            "total": {
                                "label": merchantName,
                                "type": "final",
                                "amount": total
                            },
                            'applicationData': btoa(JSON.stringify({
                                'apple_pay_domain': domain
                            }))
                        };
                    },
                    loadApplePayApi: function() {
                        applePayApiLoaded = applePayApiLoaded || new Promise(resolve => {
                            const script = document.createElement('script');
                            script.type = 'text/javascript';
                            script.src =  '<?= $escaper->escapeJs($urlProvider->getApplePaySdkUrl()) ?>';
                            script.async = true;
                            script.onload = resolve;
                            document.head.appendChild(script);
                        });

                        return applePayApiLoaded;
                    },
                    checkLoadedAP: function() {
                        return document.body.contains(document.querySelector('apple-pay-button'));
                    },
                    uninitialize: async function () {
                        if (!btnPlaceOrder) return;

                        btnPlaceOrder.disabled = false;
                    }
                }
            });

            if (isApplePayEnabled) {
                applePayMethod.loadApplePayApi().then(() => {
                    if (isApplePayAvailable()) return;

                    // <head> rule: survives Magewire morphs and steps rendered later
                    const style = document.createElement('style');
                    style.textContent = '#payment-method-option-payplug_payments_apple_pay {display: none !important}';
                    document.head.appendChild(style);
                });
            }
        });
    })();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
