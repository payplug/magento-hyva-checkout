declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
?>

<script>
    (() => {
        const loadTimeout = 10000;
        const widgetLoadingTimeout = 15000;
        let widgetPromise = null;

        function loadOneyMerchantApp(loaderUrl) {
            if (widgetPromise !== null) {
                return widgetPromise;
            }

            widgetPromise = new Promise((resolve, reject) => {
                let isSettled = false;
                let timer = null;

                const settle = (callback, value) => {
                    if (isSettled) {
                        return;
                    }

                    isSettled = true;
                    clearTimeout(timer);
                    callback(value);
                };

                timer = setTimeout(() => {
                    settle(reject, new Error('Oney widget loading timed out.'));
                }, loadTimeout);

                const initWidget = () => {
                    if (isSettled) {
                        return;
                    }

                    if (typeof window.loadOneyWidget !== 'function') {
                        settle(reject, new Error('Oney widget loader is not available.'));

                        return;
                    }

                    window.loadOneyWidget(() => {
                        if (window.oneyMerchantApp) {
                            settle(resolve, window.oneyMerchantApp);
                        } else {
                            settle(reject, new Error('Oney widget is not available.'));
                        }
                    });
                };

                if (typeof window.loadOneyWidget === 'function') {
                    initWidget();

                    return;
                }

                const script = document.createElement('script');
                script.src = loaderUrl;
                script.async = true;
                script.onload = initWidget;
                script.onerror = () => {
                    settle(reject, new Error('Oney widget loader could not be loaded.'));
                };

                document.head.appendChild(script);
            });

            widgetPromise.catch(() => {
                widgetPromise = null;
            });

            return widgetPromise;
        }

        hyvaCheckout.api.after(() => {
            const oneyPayments = ['oney', 'oney_without_fees'];

            oneyPayments.forEach((oneyPaymentType) => {
                const oneyType = `payplug_payments_${oneyPaymentType}`;
                const componentId = 'checkout.payment.method.' + oneyType;

                const method = {
                    isActive: false,
                    widgetRenderId: 0,
                    selectedOptionValue: '',
                    preferredOption: '',
                    initialize: async function () {
                        method.isActive = true;
                        method.selectedOptionValue = '';
                        method.setup(method.preferredOption);
                    },
                    setup: function (preferredOption) {
                        method.container = document.getElementById('pp-oney-payment');

                        if (!method.container) {
                            return;
                        }

                        method.rawConfig = method.container.dataset.config || '{}';

                        try {
                            method.config = JSON.parse(method.rawConfig);
                        } catch (e) {
                            method.config = {};
                        }

                        method.container.addEventListener('change', method.onOptionChange);

                        const options = [...method.container.querySelectorAll('input[name="oney_type"]')];
                        const option = options.find(input => input.value === preferredOption) || options[0];

                        if (option) {
                            option.checked = true;
                            method.selectOption(option.value);
                        }
                    },
                    teardown: function () {
                        method.container?.removeEventListener('change', method.onOptionChange);

                        method.clearWidget();
                        method.container = null;
                    },
                    refresh: function () {
                        const container = document.getElementById('pp-oney-payment');

                        if (container === method.container
                            && (!container || container.dataset.config === method.rawConfig)
                        ) {
                            return;
                        }

                        method.preferredOption = method.selectedOptionValue || method.preferredOption;

                        method.teardown();
                        method.selectedOptionValue = '';
                        method.setup(method.preferredOption);
                        method.updatePlaceOrderButtonLabel();
                    },
                    onOptionChange: function (event) {
                        if (event.target.name === 'oney_type') {
                            method.selectOption(event.target.value);
                        }
                    },
                    selectOption: function (type) {
                        method.selectedOptionValue = type;
                        method.updatePlaceOrderButtonLabel();
                        method.renderWidget();
                    },
                    getElement: function (name) {
                        return method.container ? method.container.querySelector(`[data-oney-${name}]`) : null;
                    },
                    renderWidget: function () {
                        const config = method.config;
                        const code = (config.business_transaction_codes || {})[method.selectedOptionValue];
                        const placeholder = method.getElement('placeholder');

                        if (!config.is_enabled || !code || !placeholder) {
                            method.showWidgetUnavailable();

                            return;
                        }

                        const renderId = ++method.widgetRenderId;
                        method.toggleNotice(false);
                        method.startWidgetLoading();

                        loadOneyMerchantApp(config.loader_url)
                            .then((oneyMerchantApp) => {
                                if (method.widgetRenderId !== renderId) {
                                    return;
                                }

                                method.getElement('loader')?.classList.add('hidden');

                                oneyMerchantApp.loadCheckoutSection({
                                    options: {
                                        country: config.country,
                                        language: config.language,
                                        merchant_guid: config.merchant_guid,
                                        payment_amount: parseFloat(config.amount) || 0,
                                        filter_by: 'business_transaction_code',
                                        business_transaction_code: code,
                                        checkout_placeholder: '#' + placeholder.id,
                                        successCallback: () => {
                                            if (method.widgetRenderId === renderId) {
                                                method.stopWidgetLoading();
                                            }
                                        },
                                        errorCallback: (status, response) => {
                                            if (method.widgetRenderId === renderId) {
                                                method.handleWidgetError(status + ' - ' + response);
                                            }
                                        }
                                    }
                                });
                            })
                            .catch((error) => {
                                if (method.widgetRenderId === renderId) {
                                    method.handleWidgetError(error);
                                }
                            });
                    },
                    startWidgetLoading: function () {
                        const widget = method.getElement('widget');

                        widget.style.minHeight = (widget.offsetHeight || 200) + 'px';
                        widget.setAttribute('aria-busy', 'true');
                        method.getElement('loader')?.classList.remove('hidden');

                        clearTimeout(method.widgetLoadingTimer);
                        method.widgetLoadingTimer = setTimeout(() => {
                            method.showWidgetUnavailable();
                        }, widgetLoadingTimeout);
                    },
                    stopWidgetLoading: function () {
                        const widget = method.getElement('widget');

                        clearTimeout(method.widgetLoadingTimer);
                        method.getElement('loader')?.classList.add('hidden');

                        if (widget) {
                            widget.style.minHeight = '';
                            widget.setAttribute('aria-busy', 'false');
                        }
                    },
                    handleWidgetError: function (error) {
                        console.warn('Oney widget error', error);

                        method.showWidgetUnavailable();
                    },
                    showWidgetUnavailable: function () {
                        method.clearWidget();
                        method.toggleNotice(true);
                    },
                    clearWidget: function () {
                        method.stopWidgetLoading();
                        method.widgetRenderId++;
                        method.getElement('placeholder')?.replaceChildren();
                    },
                    toggleNotice: function (isVisible) {
                        method.getElement('notice')?.classList.toggle('hidden', !isVisible);
                    },
                    updatePlaceOrderButtonLabel: function () {
                        const button = document.querySelector('.btn-place-order');

                        if (!button) {
                            return;
                        }

                        button.innerText = method.selectedOptionValue && method.container
                            ? method.container.dataset.label.replace('%1', method.selectedOptionValue)
                            : '<?= $escaper->escapeJs(__('Place Order')) ?>';
                    },
                    uninitialize: async function () {
                        method.isActive = false;
                        method.preferredOption = method.selectedOptionValue || method.preferredOption;
                        method.teardown();
                        method.selectedOptionValue = '';
                        method.updatePlaceOrderButtonLabel();
                    },
                    validate: async function () {
                        if (!method.selectedOptionValue) {
                            const error = document.querySelector('[data-oney-error]');

                            hyvaCheckout.message.dialog(error
                                ? error.textContent.trim()
                                : '<?= $escaper->escapeJs(__('Please select a payment option for Oney.')) ?>');

                            return false;
                        }

                        try {
                            await Magewire.find(componentId).call('setOneyType', method.selectedOptionValue);
                        } catch (e) {
                            console.warn('Hyva Checkout Payplug Oney: Magewire setOneyType not available', e);
                        }

                        return true;
                    }
                };

                hyvaCheckout.payment.registerMethod({
                    code: oneyType,
                    method: method
                });

                const hookMagewire = () => {
                    Magewire.hook('message.processed', (message, component) => {
                        if (method.isActive && component.id === componentId) {
                            method.refresh();
                        }
                    });
                };

                if (window.Magewire) {
                    hookMagewire();
                } else {
                    window.addEventListener('magewire:available', hookMagewire, {once: true});
                }
            });
        });
    })();
</script>

<?php $hyvaCsp->registerInlineScript() ?>
